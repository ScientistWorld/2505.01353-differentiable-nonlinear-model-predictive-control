# Apptainer definition file for differentiable MPC reproduction.
# Build:  apptainer build container.sif container.def
#
# Uses CUDA base for cmake/build tools needed to compile acados.

Bootstrap: docker
From: nvidia/cuda:12.1.0-runtime-ubuntu22.04

%post
    # Install build tools, cmake, and Python
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        cmake make gcc g++ git wget curl \
        libomp-dev libgl1-mesa-glx libglib2.0-0 \
        tmux nano vim-tiny less sudo && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Python dependencies are vendored into the workspace under
    # `environment/vendor_py310` and loaded via `PYTHONPATH` at runtime.
    #
    # Keep setup as a no-op to avoid cluster-specific overlay/package-manager
    # failures. The authoritative dependency acquisition path is `scripts/download.sh`.
    
    set -e
    
    echo "setup.sh: no-op; runtime uses vendored workspace wheels from environment/vendor_py310."

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export ACADOS_SOURCE_DIR=/home/user/method/acados
    export LD_LIBRARY_PATH=/home/user/method/acados/lib:${LD_LIBRARY_PATH}
